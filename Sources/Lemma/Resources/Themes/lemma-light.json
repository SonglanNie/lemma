 "tokenColors": [
  {
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "fontStyle": "italic",
    "foreground": "#7F7A6D"
   }
  },
  {
   "scope": [
    "keyword",
    "storage.type",
    "storage.modifier",
    "keyword.control"
   ],
   "settings": {
    "foreground": "#813B91"
   }
  },
  {
   "scope": [
    "string",
    "string.quoted"
   ],
   "settings": {
    "foreground": "#3A732C"
   }
  },
  {
   "scope": [
    "constant.numeric"
   ],
   "settings": {
    "foreground": "#AA5910"
   }
  },
  {
   "scope": [
    "constant.language",
    "variable.language"
   ],
   "settings": {
    "foreground": "#B33736"
   }
  },
  {
   "scope": [
    "entity.name.function",
    "support.function"
   ],
   "settings": {
    "foreground": "#0C60A3"
   }
  },
  {
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "support.class",
    "support.type"
   ],
   "settings": {
    "foreground": "#856302"
   }
  },
  {
   "scope": [
    "keyword.operator",
    "punctuation"
   ],
   "settings": {
    "foreground": "#0C6A76"
   }
  },
  {
   "scope": [
    "variable.parameter"
   ],
   "settings": {
    "foreground": "#A55A37"
   }
  },
  {
   "scope": [
    "markup.heading"
   ],
   "settings": {
    "fontStyle": "bold",
    "foreground": "#535C02"
   }
  }
 ]
