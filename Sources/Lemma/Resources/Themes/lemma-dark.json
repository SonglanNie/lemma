 "tokenColors": [
  {
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "fontStyle": "italic",
    "foreground": "#858073"
   }
  },
  {
   "scope": [
    "keyword",
    "storage.type",
    "storage.modifier",
    "keyword.control"
   ],
   "settings": {
    "foreground": "#D7A0E3"
   }
  },
  {
   "scope": [
    "string",
    "string.quoted"
   ],
   "settings": {
    "foreground": "#9CCF7F"
   }
  },
  {
   "scope": [
    "constant.numeric"
   ],
   "settings": {
    "foreground": "#F2AD73"
   }
  },
  {
   "scope": [
    "constant.language",
    "variable.language"
   ],
   "settings": {
    "foreground": "#FDA19A"
   }
  },
  {
   "scope": [
    "entity.name.function",
    "support.function"
   ],
   "settings": {
    "foreground": "#7BD0F9"
   }
  },
  {
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "support.class",
    "support.type"
   ],
   "settings": {
    "foreground": "#E2CE80"
   }
  },
  {
   "scope": [
    "keyword.operator",
    "punctuation"
   ],
   "settings": {
    "foreground": "#90CACD"
   }
  },
  {
   "scope": [
    "variable.parameter"
   ],
   "settings": {
    "foreground": "#F4C1A5"
   }
  },
  {
   "scope": [
    "markup.heading"
   ],
   "settings": {
    "fontStyle": "bold",
    "foreground": "#CAD879"
   }
  }
 ]
